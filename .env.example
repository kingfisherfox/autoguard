# Autoguard — OPTIONAL environment overrides. You do NOT need this file: the setup wizard in the browser asks for
# everything. Use it only if you prefer to keep keys in a secrets manager / .env instead of the app's database.
# Copy to `.env` (never commit it). Anything set here shows as "provided by the server environment" in the UI
# and can't be changed there.

# Host port for the dashboard (default 8095)
# AUTOGUARD_PORT=8095

# NextDNS API key — https://my.nextdns.io/account → API
# NEXTDNS_API_KEY=

# Any OpenAI-compatible chat-completions API
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.4-mini
# LLM_API_KEY=
# LLM_JSON_MODE=auto            # auto | schema | object | prompt  (Anthropic: prompt)
# LLM_EXTRA_JSON={}             # extra request fields, e.g. {"reasoning_effort": "low"}

# Bearer token for GET /api/status.json and /api/denylist.json (otherwise generated at setup)
# AUTOGUARD_API_TOKEN=

# Time zone for the dashboard and bedtime highlighting (otherwise chosen in the wizard)
# TZ=Europe/London
