# secrets + runtime data — never commit
.env
data/
*.db
*.db-*
*.lock
__pycache__/
*.pyc
.DS_Store

# secrets in any form (the template stays public)
.env.*
!.env.example
*.pem
*.key
secrets/

# backups and database copies (hold keys, password hashes and real family data)
*.sqlite
*.sqlite3
*.bak
backups/
autoguard-backups/

